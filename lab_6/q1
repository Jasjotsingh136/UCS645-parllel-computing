#include <stdio.h>
#include <cuda_runtime.h>

int main() {
    int gpu_total;
    cudaGetDeviceCount(&gpu_total);

    printf("Number of CUDA devices: %d\n\n", gpu_total);

    for (int dev_index = 0; dev_index < gpu_total; dev_index++) {
        cudaDeviceProp gpu_info;
        cudaGetDeviceProperties(&gpu_info, dev_index);

        printf("Device %d: %s\n", dev_index, gpu_info.name);
        printf("Compute Capability: %d.%d\n", gpu_info.major, gpu_info.minor);
        printf("Total Global Memory: %zu MB\n", gpu_info.totalGlobalMem / (1024 * 1024));
        printf("Shared Memory per Block: %zu KB\n", gpu_info.sharedMemPerBlock / 1024);
        printf("Constant Memory: %zu KB\n", gpu_info.totalConstMem / 1024);
        printf("Warp Size: %d\n", gpu_info.warpSize);
        printf("Max Threads per Block: %d\n", gpu_info.maxThreadsPerBlock);
        printf("Max Block Dimensions: %d x %d x %d\n",
               gpu_info.maxThreadsDim[0], gpu_info.maxThreadsDim[1], gpu_info.maxThreadsDim[2]);
        printf("Max Grid Dimensions: %d x %d x %d\n",
               gpu_info.maxGridSize[0], gpu_info.maxGridSize[1], gpu_info.maxGridSize[2]);
        printf("Multiprocessor Count: %d\n", gpu_info.multiProcessorCount);
        printf("Double Precision Support: %s\n\n",
               (gpu_info.major >= 1 && gpu_info.minor >= 3) ? "Yes" : "No");
    }

    return 0;}
